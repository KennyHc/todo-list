{
  "name": "todo-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "test:emulators": "npx --yes firebase-tools@15 emulators:exec --only auth,firestore --project demo-tasks \"vitest run --config vitest.emulator.config.ts\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^12.19.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.59.0",
    "nanoid": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^8.57.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.1.1",
    "typescript": "~6.0.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "~4.0.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2"
  }
}
