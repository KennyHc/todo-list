# Firebase web config (public by design; security comes from Firestore rules).
# Copy to .env.local and fill in, or run: firebase apps:sdkconfig WEB <appId>
VITE_FIREBASE_API_KEY=
# Must be the hosting domain the app is served from (production: tasks-app-956r6.web.app), not
# <project>.firebaseapp.com. Firebase Hosting serves /__/auth/handler on it; a different domain
# breaks sign-in on phones (storage partitioning), so the user comes back signed out.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 to use the local Firebase emulators (auth + firestore) instead of production.
VITE_USE_EMULATORS=
